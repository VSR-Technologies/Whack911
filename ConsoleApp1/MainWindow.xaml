<Window x:Class="Whack911.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WHACK911 CONSOLE — v0.7 BETA" Height="820" Width="1300"
        Background="#0A0E14"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#12181F"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2A3542"/>
        <SolidColorBrush x:Key="SelectedBorder" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#FFB000"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#00E676"/>
        <SolidColorBrush x:Key="RedBrush" Color="#FF3B30"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E4EAF0"/>
        <SolidColorBrush x:Key="TextDim" Color="#5C6B7A"/>

        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0A0E14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="KeypadButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP STATUS BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="3" Padding="18,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="WHACK911" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="DISPATCH CONSOLE" Foreground="{StaticResource TextDim}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#2A3542" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="v0.7 BETA" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00:00" Foreground="{StaticResource TextPrimary}"
                           FontSize="18" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse x:Name="RegStatusDot" Width="10" Height="10" Fill="{StaticResource RedBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RegStatusText" Text="OFFLINE" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Column="3" Content="⚙ SETTINGS" Style="{StaticResource IconButton}" Click="OpenSettings_Click"/>
            </Grid>
        </Border>

        <!-- ===== MIDDLE: LINES (left) + KEYPAD (right) ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LINE PANELS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="Line1Panel" Grid.Row="0" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource SelectedBorder}" BorderThickness="2" CornerRadius="3"
                        Margin="0,0,0,10" MouseLeftButtonUp="Line1_Selected">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LINE 1" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Bold"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="Line1StatusText" Text="STANDBY" Foreground="{StaticResource TextDim}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="Line1PartyText" Text="" Foreground="{StaticResource TextPrimary}" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Line1TimerText" Text="" Foreground="{StaticResource GreenBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="Line1Answer" Content="ANSWER" Style="{StaticResource ConsoleButton}" Background="{StaticResource GreenBrush}" Margin="4" Visibility="Collapsed" Click="Line1Answer_Click"/>
                            <Button x:Name="Line1Hold" Content="HOLD" Style="{StaticResource ConsoleButton}" Background="{StaticResource AmberBrush}" Margin="4" IsEnabled="False" Click="Line1Hold_Click"/>
                            <Button x:Name="Line1Hangup" Content="RELEASE" Style="{StaticResource ConsoleButton}" Background="{StaticResource RedBrush}" Foreground="White" Margin="4" IsEnabled="False" Click="Line1Hangup_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="Line2Panel" Grid.Row="1" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="2" CornerRadius="3"
                        MouseLeftButtonUp="Line2_Selected">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LINE 2" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Bold"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="Line2StatusText" Text="STANDBY" Foreground="{StaticResource TextDim}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="Line2PartyText" Text="" Foreground="{StaticResource TextPrimary}" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Line2TimerText" Text="" Foreground="{StaticResource GreenBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="Line2Answer" Content="ANSWER" Style="{StaticResource ConsoleButton}" Background="{StaticResource GreenBrush}" Margin="4" Visibility="Collapsed" Click="Line2Answer_Click"/>
                            <Button x:Name="Line2Hold" Content="HOLD" Style="{StaticResource ConsoleButton}" Background="{StaticResource AmberBrush}" Margin="4" IsEnabled="False" Click="Line2Hold_Click"/>
                            <Button x:Name="Line2Hangup" Content="RELEASE" Style="{StaticResource ConsoleButton}" Background="{StaticResource RedBrush}" Foreground="White" Margin="4" IsEnabled="False" Click="Line2Hangup_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ACTIVITY LOG -->
                <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,10,0,0" Height="120">
                    <StackPanel>
                        <TextBlock Text="ACTIVITY LOG" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,6"/>
                        <ScrollViewer Height="80" VerticalScrollBarVisibility="Auto" x:Name="LogScroller">
                            <TextBlock x:Name="LogText" Foreground="{StaticResource CyanBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KEYPAD / TRANSFER PANEL -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="3" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SELECTED LINE" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SelectedLineText" Grid.Row="1" Text="LINE 1" Foreground="{StaticResource CyanBrush}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                    <UniformGrid Grid.Row="2" Columns="3" Rows="4">
                        <Button Content="1" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="2" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="3" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="4" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="5" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="6" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="7" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="8" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="9" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="*" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="0" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                        <Button Content="#" Style="{StaticResource KeypadButton}" Click="Keypad_Click"/>
                    </UniformGrid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="BLIND TRANSFER TO" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TransferBox" Background="#0A0E14" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" FontSize="14"
                                 KeyDown="TransferBox_KeyDown"/>
                        <Button Content="TRANSFER" Style="{StaticResource ConsoleButton}" Background="{StaticResource AmberBrush}"
                                Margin="0,8,0,0" Click="Transfer_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== OUTBOUND DIAL ROW ===== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- LOCAL DIAL (no prefix) -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LOCAL EXT" Foreground="{StaticResource TextDim}" FontSize="12"
                           VerticalAlignment="Center" Width="90"/>
                <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="3" Padding="14,8">
                    <Grid>
                        <TextBlock x:Name="LocalPlaceholder" Text="EXTENSION" Foreground="{StaticResource TextDim}"
                                   FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="LocalDialBox" Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0" FontSize="16" CaretBrush="{StaticResource AmberBrush}"
                                 VerticalContentAlignment="Center" Text=""
                                 TextChanged="LocalDialBox_TextChanged" KeyDown="LocalDialBox_KeyDown"/>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Content="CALL" Style="{StaticResource ConsoleButton}"
                        Background="{StaticResource CyanBrush}" Margin="10,0,0,0" Width="120" FontSize="16"
                        Click="LocalCall_Click"/>
            </Grid>

            <!-- OUTBOUND DIAL (prefix applied) -->
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="OutboundLabel" Text="OUTBOUND" Foreground="{StaticResource TextDim}" FontSize="12"
                           VerticalAlignment="Center" Width="90"/>
                <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="3" Padding="14,8">
                    <Grid>
                        <TextBlock x:Name="OutboundPlaceholder" Text="PHONE NUMBER" Foreground="{StaticResource TextDim}"
                                   FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="OutboundDialBox" Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0" FontSize="16" CaretBrush="{StaticResource AmberBrush}"
                                 VerticalContentAlignment="Center" Text=""
                                 TextChanged="OutboundDialBox_TextChanged" KeyDown="OutboundDialBox_KeyDown"/>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Content="CALL" Style="{StaticResource ConsoleButton}"
                        Background="{StaticResource AmberBrush}" Margin="10,0,0,0" Width="120" FontSize="16"
                        Click="OutboundCall_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
